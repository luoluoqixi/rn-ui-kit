{
  "name": "rn-ui-kit",
  "version": "1.2.4",
  "private": false,
  "type": "module",
  "description": "React Native UI kit with core components and debug tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/luoluoqixi/rn-ui-kit.git"
  },
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "react-native": "./src/core.ts",
      "types": "./src/core.ts",
      "default": "./src/core.ts"
    },
    "./debug": {
      "react-native": "./src/debug.ts",
      "types": "./src/debug.ts",
      "default": "./src/debug.ts"
    },
    "./initialize": {
      "react-native": "./src/initialize.ts",
      "types": "./src/initialize.ts",
      "default": "./src/initialize.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "patches",
    "scripts/clear-patch-cache.mjs",
    "scripts/sync-patches.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "package-release": "node scripts/release/package.cjs",
    "release:android-apk": "node scripts/android/release-example-apk.cjs",
    "release:notes": "node scripts/release/generate-notes.cjs",
    "set-version": "node scripts/release/set-version.cjs",
    "clear-patch-cache": "bun scripts/clear-patch-cache.mjs",
    "sync-patches": "bun scripts/sync-patches.mjs",
    "test": "bun test test",
    "typecheck": "bun run typecheck:library && bun run --cwd examples/app typecheck",
    "typecheck:library": "tsc --noEmit --pretty false"
  },
  "overrides": {
    "@babel/runtime": "7.29.7"
  },
  "dependencies": {
    "sf-symbols-typescript": "=2.2.0"
  },
  "devDependencies": {
    "@expo/ui": "=55.0.17",
    "@lodev09/react-native-true-sheet": "=3.11.6",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/elements": "^2.9.38",
    "@react-navigation/native": "=7.3.16",
    "@react-navigation/native-stack": "=7.18.8",
    "@react-navigation/stack": "^7.10.6",
    "@shopify/flash-list": "=2.3.2",
    "@tamagui/config": "=2.7.7",
    "@tamagui/lucide-icons-2": "=2.7.7",
