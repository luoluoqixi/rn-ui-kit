    "@tamagui/toast": "=2.7.7",
    "@types/react": "=19.2.16",
    "babel-preset-expo": "^55.0.22",
    "burnt": "^0.13.0",
    "expo": "=55.0.26",
    "expo-glass-effect": "=55.0.11",
    "expo-haptics": "=55.0.14",
    "expo-modules-core": "=55.0.25",
    "expo-status-bar": "=55.0.6",
    "react": "=19.2.5",
    "react-dom": "=19.2.5",
    "react-native": "=0.83.9",
    "react-native-gesture-handler": "=2.31.1",
    "react-native-keyboard-controller": "=1.22.4",
    "react-native-reanimated": "=4.3.0",
    "react-native-safe-area-context": "=5.7.0",
    "react-native-screens": "=4.24.0",
    "react-native-svg": "^15.15.5",
    "react-native-teleport": "^1.1.7",
    "react-native-web": "=0.21.2",
    "react-native-worklets": "=0.8.1",
    "tamagui": "=2.7.7",
    "typescript": "=5.9.2",
    "zeego": "=3.0.6"
  },
  "bin": {
    "rn-ui-clear-patch-cache": "./scripts/clear-patch-cache.mjs",
    "rn-ui-sync-patches": "./scripts/sync-patches.mjs"
  },
