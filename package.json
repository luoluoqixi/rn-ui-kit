{
  "name": "rn-ui-kit",
  "version": "1.3.6",
  "private": false,
  "type": "module",
  "description": "React Native UI kit with core components and debug tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/luoluoqixi/rn-ui-kit.git"
  },
  "main": "./dist/index.js",
  "react-native": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "react-native": "./src/core.ts",
      "default": "./dist/core.js"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "react-native": "./src/debug.ts",
      "default": "./dist/debug.js"
    },
    "./initialize": {
      "types": "./dist/initialize.d.ts",
      "react-native": "./src/initialize.ts",
      "default": "./dist/initialize.js"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "patches",
    "scripts/sync-patches.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync-patches": "bun scripts/sync-patches.mjs"
  },
  "overrides": {
    "@babel/runtime": "7.29.7"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@rn-primitives/accordion": "=1.5.2",
    "@rn-primitives/alert-dialog": "=1.5.2",
    "@rn-primitives/aspect-ratio": "=1.5.2",
    "@rn-primitives/avatar": "=1.5.2",
    "@rn-primitives/checkbox": "=1.5.2",
    "@rn-primitives/collapsible": "=1.5.2",
    "@rn-primitives/context-menu": "=1.5.2",
    "@rn-primitives/dialog": "=1.5.2",
    "@rn-primitives/dropdown-menu": "=1.5.2",
    "@rn-primitives/label": "=1.5.2",
    "@rn-primitives/menubar": "=1.5.2",
    "@rn-primitives/popover": "=1.5.2",
    "@rn-primitives/portal": "=1.4.0",
    "@rn-primitives/progress": "=1.5.2",
    "@rn-primitives/radio-group": "=1.5.2",
    "@rn-primitives/select": "=1.5.2",
    "@rn-primitives/separator": "=1.5.2",
    "@rn-primitives/slot": "=1.5.2",
    "@rn-primitives/switch": "=1.5.2",
    "@rn-primitives/tabs": "=1.5.2",
    "@rn-primitives/toggle": "=1.5.2",
    "@rn-primitives/toggle-group": "=1.5.2",
    "@rn-primitives/tooltip": "=1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react-native": "^1.21.0",
    "reanimated-color-picker": "^5.1.3",
    "sf-symbols-typescript": "=2.2.0",
    "sonner": "2.0.8",
    "sonner-native": "0.27.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "bin": {
    "rn-ui-clear-patch-cache": "./scripts/clear-patch-cache.mjs",
    "rn-ui-sync-patches": "./scripts/sync-patches.mjs"
  },
  "peerDependencies": {
    "@lodev09/react-native-true-sheet": "=3.11.12",
