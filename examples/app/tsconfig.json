{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "declaration": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "paths": {
      "rn-ui-kit": ["../../src/index.ts"],
      "rn-ui-kit/*": ["../../src/*"]
    }
  },
  "include": [
    "App.tsx",
    "styles.d.ts",
    "app.config.ts",
    "uniwind-types.d.ts",
    "*.js",
    "../../src/**/*.ts",
    "../../src/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
