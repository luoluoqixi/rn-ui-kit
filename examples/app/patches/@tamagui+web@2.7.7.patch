+++ b/dist/cjs/eventHandling.native.js
@@ -77,6 +77,24 @@ function useEvents(events, viewProps, stateRef, staticConfig, isHOC, isInsideNat
     if (events.onBlur) {
       viewProps["onBlur"] = events.onBlur;
     }
+    if (import_react_native.Platform.OS === "android") {
+      if (events.onPress) {
+        var press = events.onPress;
+        viewProps["onClick"] = function (event) {
+          if (!event.nativeEvent || event.nativeEvent.pointerType == null) {
+            press(event);
+          }
+        };
+      }
+      if (events.onLongPress) {
+        var longPress = events.onLongPress;
+        viewProps["onLongClick"] = function (event) {
+          if (!event.nativeEvent || event.nativeEvent.pointerType == null) {
+            longPress(event);
+          }
+        };
+      }
+    }
     if (getIsNativeDesktop()) {
       if (events.onMouseEnter) {
         viewProps["onMouseEnter"] = events.onMouseEnter;
